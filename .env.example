# Public site URL used for canonical links, sitemap, and Open Graph.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mytechstop.com

# WhatsApp numbers in international format, digits only or with a leading +.
# These values are public because they appear in wa.me links.
# Leave blank to hide WhatsApp actions. Do not invent numbers.
NEXT_PUBLIC_WHATSAPP_ENGLISH=
NEXT_PUBLIC_WHATSAPP_SPANISH=

# Optional analytics IDs. Scripts load only when an ID is present.
# None of these are secret. Do not put API secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# GoHighLevel. Server-only. Leave blank until a company account is connected.
# The website does not call GoHighLevel until these are set AND the HTTP
# integration in src/lib/ghl/client.ts is implemented and tested.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=

# AI provider. Server-only. Leave blank to keep the scripted sales assistant.
# Do not install a provider SDK until cost is approved.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Quantity at or above this number is marked priority on a lead.
# Leave blank to disable priority. Do not guess a threshold.
LEAD_PRIORITY_QUANTITY=

# Uploads.
# development: files are stored under storage/uploads (gitignored).
# production: set UPLOAD_DRIVER=local only on a server with a persistent disk.
# Otherwise uploads are refused and the form explains that storage is not connected.
UPLOAD_DRIVER=
UPLOAD_LOCAL_DIR=
UPLOAD_MAX_BYTES=8388608

# Local preview only. Simulates an edge country header, for example CO or US.
# Never set this in production.
MTS_DEV_COUNTRY=
